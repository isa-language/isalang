@import "std.box"
struct Pair {
  count: i32,
  left: String,
  right: String,
}
fn marker() {}
fn first() {
  print(101);
}
fn second() {
  print(202);
}
fn main() {
  let pair = Pair {
    count: 7,
    left: String::from("left"),
    right: String::from("right")
  };
  let later = String::from("later");
  marker();
  let left = pair.left.move();
  first();
  print(left);
  print(pair.count);
  pair.left = String::from("new");
  pair.right.drop();
  second();
  print(pair.left.as_str());
  print(pair.count);
  print(later);
}
