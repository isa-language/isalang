@import "std.box"
struct Pair {
  left: String,
  right: String,
}
fn marker() {}
fn make() -> String {
  print(303);
  return String::from("argument");
}
fn first(value: String) {
  print(value);
}
fn main() {
  let pair = Pair {
    left: String::from("left"),
    right: String::from("right")
  };
  marker();
  pair.left.drop();
  first(make());
  print(pair.right.as_str());
}
