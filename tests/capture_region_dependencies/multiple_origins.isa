fn choose(a: &i32[], b: &i32[], left: bool) -> Option<&i32> {
  if left {
    return a.first();
  }
  return b.last();
}
fn main() {
  let a = [10, 20];
  let b = [30, 40];
  let first = choose(&a, &b, true);
  match first {
    Some(value) => print(value),
    None => {}
  }
  let last = choose(&a, &b, false);
  match last {
    Some(value) => print(value),
    None => {}
  }
  a[0] = 11;
  b[1] = 41;
  print(a[0]);
  print(b[1]);
}
