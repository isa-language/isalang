@import("std.box", "std.vec")
fn inspect(values: &i32[]) -> i32 {
  return values[0];
}
fn edit(values: &mut i32[]) {
  values[0] = 42;
}
fn main() {
  let values = Vec<i32>::new();
  values.push(1);
  values.push(2);
  let descriptor = &values;
  print(descriptor.len());
  let view = values.as_slice();
  print(inspect(view));
  let change = values.as_mut_slice();
  edit(change);
  print(values.at_copy(0));
  let boxed = Box<i32>::new(30);
  let reference = boxed.get();
  print(reference);
  let array = [10, 20];
  print(inspect(&array));
  edit(&mut array);
  print(array[0]);
}
