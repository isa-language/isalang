extern "C" fn sum(count: i32,...) -> i64;
extern "C" fn average(count: i32,...) -> f64;
fn main() {
  let small: i8 = -7;
  let byte: u8 = 250;
  let word: u16 = 60000;
  let real: f32 = 1.5;
  unsafe {
    let total = sum(4, small, byte, word, true);
    @assert(total == 60244i64);
    @assert(sum(2, 10, 32) == 42i64);
    @assert(sum(0) == 0i64);
    @assert(average(2, real, 2.5) == 2.0);
    @println("{} {}", total, average(2, real, 2.5));
  }
}
