enum Pair<A, B> {
  Values(A, B),
  Empty,
}
fn first(input: Pair<&i32, &i32>) -> Option<&i32> {
  match input {
    Pair::Values(a, b) => {
      return Option::Some(a);
    },
    Pair::Empty => {
      return Option::None;
    },
  }
}
fn main() {
  let a = 1;
  let b = 2;
  let view = first(Pair::Values(&a, &b));
  b = 3;
  match view.move() {
    Some(value) => {
      print(value);
    },
    None => {}
  }
}
