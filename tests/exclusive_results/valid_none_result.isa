@import "std.vec"
fn at(values: &mut Vec<i32>, index: usize) -> Option<&mut i32> {
  return values.get_mut(index);
}
fn absent(values: &mut i32[]) -> Option<&mut i32> {
  return Option<&mut i32>::None;
}
fn main() {
  let v = Vec<i32>::new();
  let edit = &mut v;
  let missing = at(edit, 0);
  print(missing.is_none());
  missing.drop();
  edit.push(42);
  let data = [1];
  let s: &mut i32[] = &mut data;
  let result = absent(s);
  print(result.is_none());
  result.drop();
  s[0] = 10;
  print(data[0]);
  print(v.at_copy(0));
}
