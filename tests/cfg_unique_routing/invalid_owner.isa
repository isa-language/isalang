struct Views {
  first: &mut i32,
  second: &mut i32,
}
struct View {
  value: &mut i32,
}
fn forward(input: Views) -> Views {
  loop {
    return input.move();
  }
}
fn main() {
  let a = 1;
  let b = 2;
    let output = forward(Views {
      first: &mut a,
      second: &mut b
  });
  a.drop();
  output.drop();
}
