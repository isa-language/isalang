struct Views {
  first: &mut i32,
  second: &mut i32,
}
struct View {
  value: &mut i32,
}
fn forward(input: Views) -> Views {
  loop {
    return input.move();
  }
}
fn main() {
  let a = 1;
  let b = 2;
  let x = &mut a;
  let y = &mut b;
    let output = forward(Views {
      first: x,
      second: y
  });
  x = 10;
  output.drop();
}
