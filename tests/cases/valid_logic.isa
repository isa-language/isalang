fn side() -> bool {
  print(99);
  return true;
}
fn main() -> i32 {
  print(false && side());
  print(true || side());
  print(true && side());
  print(false || side());
  print(true &&(false || true));
  print(!(3 > 2));
  print(-2147483648);
  print(2147483647 + 1);
  print(20 / 4);
  return 0;
}
