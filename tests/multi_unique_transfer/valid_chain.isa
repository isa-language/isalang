struct Views {
  number: &mut i32,
  flag: &mut bool,
}
fn forward(input: Views) -> Views {
  return input.move();
}
fn relay(input: Views) -> Views {
  return forward(input.move());
}
fn main() {
  let data = 1;
  let flag = false;
      let result = relay(forward(Views {
        number: &mut data,
        flag: &mut flag
  }));
  let edit = &mut result.number;
  edit = 42;
  let mark = &mut result.flag;
  mark = true;
  result.drop();
  print(data);
  print(flag);
}
