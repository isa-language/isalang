@import "std.buffer"
struct Views {
  number: &mut i32,
  flag: &mut bool,
  owner: Buffer,
}
fn forward(input: Views) -> Views {
  return input.move();
}
fn main() {
  let data = 1;
  let flag = false;
    let result = forward(Views {
      number: &mut data,
      flag: &mut flag,
      owner: Buffer::new(3)
  });
  let edit = &mut result.number;
  edit = 42;
  let owner = result.owner.move();
  print(owner.len());
  owner.release();
  result.drop();
  print(data);
  print(flag);
}
