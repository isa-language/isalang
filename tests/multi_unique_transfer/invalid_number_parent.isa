struct Views {
  number: &mut i32,
  flag: &mut bool,
}
fn forward(input: Views) -> Views {
  return input.move();
}
fn main() {
  let data = 1;
  let flag = false;
  let a = &mut data;
  let b = &mut flag;
    let result = forward(Views {
      number: a,
      flag: b
  });
  a = 2;
  print(result.number);
  result.drop();
}
