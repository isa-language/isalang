struct View<T> {
  value: &mut T,
}
impl<T> View<T> {
  pub fn forward(input: View<T>) -> View<T> {
    return input.move();
  }
}
fn main() {
  let data = 1;
    let result = View<i32>::forward(View<i32> {
      value: &mut data
  });
  let edit = &mut result.value;
  edit = 42;
  result.drop();
  print(data);
}
