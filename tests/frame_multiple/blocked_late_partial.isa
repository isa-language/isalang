@import "std.box"
struct Pair {
  left: String,
  right: String,
}
fn marker() {}
fn first() {}
fn second() {}
fn main() {
  let pair = Pair {
    left: String::from("left"),
    right: String::from("right")
  };
  marker();
  first();
  let left = pair.left.move();
  second();
  print(left);
  print(pair.right.as_str());
}
