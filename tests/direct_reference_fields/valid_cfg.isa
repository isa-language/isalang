struct View {
  value: &i32,
}
fn branch(condition: bool) {
  let number = 10;
  let view = View {
    value: &number
  };
  let alias = view.value;
  view.drop();
  if condition {
    print(alias);
    return;
  }
  print(alias);
  number = 11;
  print(number);
}
fn main() -> i32 {
  branch(true);
  branch(false);
  let number = 20;
  let i = 0;
  while i < 3 {
    let view = View {
      value: &number
    };
    let alias = view.value;
    view.drop();
    print(alias);
    number = number + 1;
    i = i + 1;
  }
  return 0;
}
