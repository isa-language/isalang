struct Holder {
  value: Option<&mut i32>,
}
fn main() {
  let old = [1];
  let fresh = [2];
  let first = &mut old;
  let second = &mut fresh;
  let holder = Holder {
    value: first.get_mut(0)
  };
  holder.value = second.get_mut(0);
  old[0] = 3;
  print(old[0]);
  let value = holder.value.move();
  holder.drop();
  match value {
    Some(item) => {
      item = 4;
    },
    None => {}
  }
  print(fresh[0]);
}
