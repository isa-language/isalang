struct Holder {
  value: Option<&mut i32>,
}
fn main() {
  let data = [0];
  let edit = &mut data;
  let count = 0;
  loop {
    let holder = Holder {
      value: edit.first_mut()
    };
    count = count + 1;
    if count == 2 {
      continue;
    }
    let value = holder.value.move();
    match value {
      Some(item) => {
        item = item + 1;
      },
      None => {}
    }
    if count == 3 {
      break;
    }
  }
  print(edit[0]);
  print(data[0]);
}
