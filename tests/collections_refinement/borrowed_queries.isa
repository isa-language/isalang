@import("std.vec", "std.result")
fn main() {
  let v = Vec<i32>::new();
  v.push(42);
  let first = v.get(0);
  let absent = v.get(1);
  @assert(first.is_some() && !first.is_none());
  @assert(absent.is_none());
  match first {
    Some(value) => {
      @assert(value == 42);
    },
    None => {
      @assert(false);
    }
  }
  let owned = Option::Some(String::from("held"));
  let shared = owned.as_ref();
  @assert(shared.is_some());
  match shared {
    Some(value) => {
      @assert(value == "held");
    },
    None => {
      @assert(false);
    }
  }
  let result: Result<String, String> = Result::Err(String::from("error"));
  let view = result.as_ref();
  @assert(view.is_err() && !view.is_ok());
  match view {
    Err(error) => {
      @assert(error == "error");
    },
    Ok(_) => {
      @assert(false);
    }
  }
  print("borrowed queries ok");
}
