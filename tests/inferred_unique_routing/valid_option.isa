struct Views {
  first: &mut i32,
  second: &mut i32,
}
fn select(input: Views, empty: bool) -> Option<&mut i32> {
  if empty {
    return Option::None;
  }
  return Option::Some(input.second.move());
}
fn exercise(empty: bool) {
  let a = 1;
  let b = 2;
  let x = &mut a;
  let y = &mut b;
    let result = select(Views {
      first: x,
      second: y
  }, empty);
  x = 10;
  match result {
    Some(edit) => {
      edit = 20;
    },
    None => {
      print(7);
    }
  }
  y = 21;
  print(x);
  print(y);
}
fn main() {
  exercise(false);
  exercise(true);
}
