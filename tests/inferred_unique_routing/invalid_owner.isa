struct Views {
  first: &mut String,
  second: &mut String,
}
fn forward(input: Views) -> Views {
  return input.move();
}
fn main() {
  let a = String::from("a");
  let b = String::from("b");
    let result = forward(Views {
      first: &mut a,
      second: &mut b
  });
  b.drop();
  print(result.second);
  result.drop();
}
