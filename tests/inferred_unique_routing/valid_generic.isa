struct Views<T> {
  first: &mut T,
  second: &mut T,
}
impl<T> Views<T> {
  fn forward(input: Views<T>) -> Views<T> {
    return input.move();
  }
}
fn main() {
  let a = 1;
  let b = 2;
    let result = Views<i32>::forward(Views<i32> {
      first: &mut a,
      second: &mut b
  });
  let edit = &mut result.first;
  edit = 10;
  let other = &mut result.second;
  other = 20;
  result.drop();
  print(a);
  print(b);
}
