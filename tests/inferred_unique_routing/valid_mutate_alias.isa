struct Views {
  first: &mut i32,
  second: &mut i32,
}
fn forward(input: Views) -> Views {
  let a = input.first.move();
  let b = input.second.move();
  a = 10;
  b = 20;
  return Views {
    first: a,
    second: b
  };
}
fn main() {
  let a = 1;
  let b = 2;
    let result = forward(Views {
      first: &mut a,
      second: &mut b
  });
  result.drop();
  print(a);
  print(b);
}
