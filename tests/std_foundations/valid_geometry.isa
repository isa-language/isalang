@import "std.ui.geometry"
@import "std.ui.color"
@import "std.math"
fn main() -> i32 {
  let point = Point::new();
  point.initialize(2.0f32, 3.0f32);
  point.translate(-1.0f32, 2.0f32);
  @assert(point.x == 1.0f32 && point.y == 5.0f32);
  let rect = Rect::new();
  rect.initialize(0.0f32, 0.0f32, 10.0f32, 10.0f32);
  @assert(rect.contains(0.0f32, 0.0f32));
  @assert(!rect.contains(10.0f32, 5.0f32));
  rect.width = -1.0f32;
  @assert(!rect.contains(0.0f32, 0.0f32));
  let color = Color::new();
  color.initialize(255u8, 0u8, 0u8, 255u8);
  @assert(color.rgba() == 4278190335u32);
  @assert(clamp_i32(20, 0, 10) == 10);
  print(1);
  return 0;
}
