fn main() {
  let matrix: i32[2][3] = {
    {
      1,
      2,
      3
    },
    {
      4,
      5,
      6
    }
  };
  for row in &matrix {
    for value in row {
      print(value);
    }
  }
  for row in &mut matrix {
    for value in row {
      *value = *value * 2;
    }
  }
  for row in matrix {
    for value in row {
      print(value);
    }
  }
  let cube: i32[2][1][2][1] = {
    {
      {
        {
          1
        },
        {
          2
        }
      }
    },
    {
      {
        {
          3
        },
        {
          4
        }
      }
    }
  };
  for a in &mut cube {
    for b in a {
      for c in b {
        for value in c {
          *value = *value + 10;
        }
      }
    }
  }
  for a in &cube {
    for b in a {
      for c in b {
        for value in c {
          print(value);
        }
      }
    }
  }
}
