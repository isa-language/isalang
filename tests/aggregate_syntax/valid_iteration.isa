@import "std.vec"
fn main() {
  let v = Vec<i32> {
    1,
    2,
    3,
    4
  };
  for value in &v {
    if value == 2 {
      continue;
    }
    print(value);
    if value == 3 {
      break;
    }
  }
  for value in &mut v {
    value = value * 10;
  }
  for value in v {
    print(value);
  }
  let a: i32[3] = {
    5,
    6,
    7
  };
  for value in &mut a {
    value = value + 1;
  }
  for value in &a {
    print(value);
  }
    for value in(Vec<i32> {
      8,
      9
  }) {
    print(value);
  }
}
