const ROWS: usize = 2;
struct Board {
  data: i32[ROWS][3],
}
fn read(m: &i32[2][3], i: usize, j: usize) -> i32 {
  return m[i][j];
}
fn main() {
  let m: i32[ROWS][3] = {
    {
      1,
      2,
      3
    },
    {
      4,
      5,
      6
    }
  };
  let i = 1usize;
  let j = 2usize;
  m[i][j] = m[i][j] + 3;
  print(m[1][2]);
  print(read(&m, i, j));
  print(m.len());
  let b = Board {
    data: {
      {
        10,
        20,
        30
      },
      {
        40,
        50,
        60
      }
    }
  };
  b.data[i][j] = 70;
  print(b.data[i][j]);
  let zeros: i32[2][3];
  print(zeros[i][j]);
  let row = &mut m[i];
  for value in row {
    value = value + 1;
  }
  print(m[1][2]);
}
