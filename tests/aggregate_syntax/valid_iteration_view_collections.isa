@import "std.vec"
@import "std.string"
fn make() -> Vec<String> {
  print(99);
  return Vec<String> {
    "a",
    "b",
    "c"
  };
}
fn start() -> usize {
  print(10);
  return 1;
}
fn end() -> usize {
  print(20);
  return 3;
}
fn main() {
  for value in make().view().slice(0, start(), end()).elements().rev() {
    print(value);
  }
  let v = Vec<i32> {
    1,
    2,
    3,
    4
  };
  for value in v.view_mut().slice(0, 1, 3).elements_mut().rev() {
    *value = *value + 10;
  }
  for value in v.view().reverse_axis(0).elements() {
    print(value);
  }
  let array = [5, 6, 7];
  let slice = &array;
  for value in slice.view().elements().rev() {
    print(value);
  }
  let words = Vec<String> {
    "a",
    "b"
  };
  for word in words.view_mut().elements_mut() {
    word.push_str("!");
  }
  for word in words.view().elements() {
    print(word);
  }
  let empty = Vec<i32>::new();
  for value in empty.view().elements().rev() {
    print(value);
  }
}
