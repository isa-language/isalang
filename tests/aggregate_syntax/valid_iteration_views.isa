fn main() {
  let matrix: i32[2][3] = {
    {
      1,
      2,
      3
    },
    {
      4,
      5,
      6
    }
  };
  for value in matrix.view().elements() {
    print(value);
  }
  for value in matrix.view().elements().rev() {
    print(value);
  }
  for value in matrix.view().transpose().elements() {
    print(value);
  }
  for value in matrix.view().reverse_axis(0).elements() {
    print(value);
  }
  for value in matrix.view().reverse_axis(1).elements() {
    print(value);
  }
  for value in matrix.view().slice(0, 1, 2).slice(1, 1, 3).elements() {
    print(value);
  }
  for value in matrix.view().permute_axes(1, 0).elements().rev() {
    print(value);
  }
  for value in matrix.view_mut().transpose().elements_mut() {
    *value = *value * 2;
  }
  for value in matrix.view().elements() {
    print(value);
  }
  for value in matrix.view().slice(0, 0, 0).elements().rev() {
    print(value);
  }
  for value in matrix.view().reverse_axis(1).slice(1, 0, 2).elements() {
    print(value);
  }
}
