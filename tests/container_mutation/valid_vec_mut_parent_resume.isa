@import "std.vec"
fn main() {
  let values = Vec<i32>::new();
  values.push(1);
  let parent = &mut values;
  let item = parent.get_mut(0);
  item.drop();
  parent.push(3);
  let next = parent.get_mut(1);
  match next {
    Some(value) => {
      print(value);
    },
    None => {}
  }
  parent.clear();
  print(values.len());
}
