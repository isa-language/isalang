@import "std.vec"
fn edit(stop: bool) -> i32 {
  let v = Vec<String>::new();
  v.push(String::from("a"));
  loop {
    match v.get_mut(0) {
      Some(r) => {
        r.push_str("b");
        print(r);
        if stop {
          return 1;
        }
      },
      None => {}
    }
    break;
  }
  v.clear();
  return 0;
}
fn main() {
  print(edit(true));
  print(edit(false));
}
