@import "std.vec"
fn sum(v: &i32[]) -> i32 {
  let result = 0;
  for i in 0usize..v.len() {
    result = result + v[i];
  }
  return result;
}
fn edit(v: &mut i32[]) {
  v[0] = 8;
}
fn main() {
  let v = Vec<i32>::new();
  v.push(1);
  v.push(2);
  let a = v.as_slice();
  let b = v.as_slice();
  print(sum(a));
  print(b[1]);
  let s = v.as_mut_slice();
  edit(s);
  print(s[0]);
  v.push(3);
  print(sum(v.as_slice()));
}
