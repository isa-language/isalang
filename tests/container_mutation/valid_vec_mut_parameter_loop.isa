@import "std.vec"
fn edit(values: &mut Vec<i32>) {
  let i = 0;
  while i<3 {
    match values.get_mut(0) {
      Some(value) => {
        value = value + 1;
      },
      None => {}
    }
    if i == 1 {
      i = i + 1;
      continue;
    }
    i = i + 1;
  }
  values.push(9);
}
fn main() {
  let values = Vec<i32>::new();
  values.push(1);
  edit(&mut values);
  print(values.at_copy(0));
}
