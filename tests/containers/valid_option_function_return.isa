fn choose(flag: bool) -> Option<usize> {
  if flag {
    return Option::Some(42usize);
  }
  return Option::None;
}
fn main() -> i32 {
  let a = choose(true);
  match a {
    Option::Some(v) => print(v),
    Option::None => print(0),
  }
  let b = choose(false);
  match b {
    Option::Some(v) => print(v),
    Option::None => print(1),
  }
  return 0;
}
