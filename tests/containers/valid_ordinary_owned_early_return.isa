struct Outer {
  value: Inner,
  spare: String,
}
struct Inner {
  value: String,
}
fn work(stop: bool) {
  let o = Outer::new();
  if stop {
    return;
  }
  let i = Inner::new();
  i.value = String::from("inner");
  o.value = i.move();
  if !stop {
    return;
  }
  o.spare = String::from("spare");
}
fn main() {
  work(true);
  work(false);
}
