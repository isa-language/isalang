struct Pair<T> {
  first: T,
  second: T,
}
struct Holder<T> {
  value: T,
}
fn main() {
  let p = Pair<String>::new();
  p.first = String::from("a");
  p.second = String::from("b");
  let q = Pair<String>::new();
  q.first = String::from("c");
  q.second = String::from("d");
  let h = Holder<Pair<String >>::new();
  h.value = p.move();
  h.value = q.move();
  h.value = h.value.move();
  h.value.drop();
}
