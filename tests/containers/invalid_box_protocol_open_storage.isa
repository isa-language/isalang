@import("std.vec", "std.box")
protocol FileState {
  initial Closed;
  final Closed;
  state Closed {
    open(self) -> Open;
  }
  state Open {
    close(self) -> Closed;
  }
}
struct File: FileState {
  x: i32,
}
impl File {
  fn open(self) {}
  fn close(self) {}
}
fn main() {
  let f = File::new();
  f.open();
  let b = Box<File>::new(f.move());
}
