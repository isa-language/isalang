@import "std.vec"
fn main() {
  let v = Vec<Option<String >>::new();
  v.push(Option::Some(String::from("some")));
  let none: Option<String> = Option::None;
  v.push(none.move());
  let last = v.pop();
  match last.move() {
    Some(option) => {
      print(option.is_none());
    },
    None => {}
  }
}
