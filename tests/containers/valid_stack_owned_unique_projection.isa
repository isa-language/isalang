struct Inner {
  prefix: i32,
  text: String,
}
struct Outer {
  prefix: i32,
  inner: Inner,
}
fn modify(i: &mut Inner) {
  i.text.push_str("!");
}
fn main() {
  let i = Inner::new();
  i.text = String::from("42");
  let o = Outer::new();
  o.inner = i.move();
  let w = &mut o.inner;
  modify(w);
  print(o.inner.text.len());
}
