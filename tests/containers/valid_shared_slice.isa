fn sum(values: &i32[]) -> i32 {
  let sum = 0;
  let i: usize = 0;
  while i<values.len() {
    sum = sum + values[i];
    i = i + 1;
  }
  return sum;
}
fn main() -> i32 {
  let a = [1, 2, 3];
  print(sum(&a));
  let b = [4, 5];
  print(sum(&b));
  let s: &i32[] = &a;
  print(s.len());
  print(s.is_empty());
  print(s[1]);
  return 0;
}
