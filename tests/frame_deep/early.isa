@import "std.box"
struct Inner {
  left: String,
  right: String,
}
struct Outer {
  inner: Inner,
}
fn marker() {}
fn first() {
  print(101);
}
fn second() {
  print(202);
}
fn main() -> i32 {
  let stop = true;
  let data = Outer {
    inner: Inner {
      left: String::from("left"),
      right: String::from("right")
    }
  };
  marker();
  data.inner.left.drop();
  first();
  if stop {
    let result = data.inner.right.move();
    print(result);
    return 0;
  }
  data.inner.left = String::from("new");
  data.inner.right.drop();
  second();
  let result = data.inner.left.move();
  print(result);
  return 0;
}
