struct View {
  value: &mut i32,
  owner: String,
}
fn main() {
  let data = 0;
  let count = 0;
  loop {
    let view = View {
      value: &mut data,
      owner: String::from("loop")
    };
    let edit = &mut view.value;
    count = count + 1;
    if count == 2 {
      continue;
    }
    edit = edit + 1;
    if count == 3 {
      break;
    }
  }
  print(data);
}
