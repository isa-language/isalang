struct View {
  value: &mut i32,
  owner: String,
}
fn early(data: &mut i32, yes: bool) -> i32 {
  let view = View {
    value: data,
    owner: String::from("early")
  };
  let edit = &mut view.value;
  if yes {
    return 1;
  }
  edit = 42;
  return 2;
}
fn main() {
  let data = 0;
  print(early(&mut data, true));
  print(early(&mut data, false));
  print(data);
}
