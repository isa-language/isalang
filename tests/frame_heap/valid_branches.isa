@import "std.box"
fn marker() {}
fn main() -> i32 {
  let text = String::from("branches");
  let value = 2;
  marker();
  if value == 1 {
    print(text);
    return 1;
  }
  let i = 0;
  while i<3 {
    i = i + 1;
    if i == 1 {
      continue;
    }
    print(text);
    if i == 2 {
      break;
    }
  }
  return 0;
}
