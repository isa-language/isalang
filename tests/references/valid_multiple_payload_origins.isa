fn choose(a: Option<&String>, b: Option<&String>, condition: bool) -> Option<&String> {
  if condition {
    return a.move();
  }
  return b.move();
}
fn forward(a: Option<&String>, b: Option<&String>, condition: bool) -> Option<&String> {
  return choose(a.move(), b.move(), condition);
}
fn main() {
  let a = String::from("a");
  let b = String::from("b");
  let result = forward(Option::Some(&a), Option::Some(&b), false);
  match result {
    Option::Some(r) => print(r),
    Option::None => {}
  }
  a.clear();
  b.clear();
  let none: Option<&String> = Option::None;
  let other: Option<&String> = Option::None;
  let empty = forward(none.move(), other.move(), true);
  a.push_str("done");
  b.clear();
  match empty {
    Option::Some(r) => print(r),
    Option::None => print(a)
  }
  let absent: Option<&String> = Option::None;
  let present = choose(absent.move(), Option::Some(&a), false);
  match present {
    Option::Some(r) => print(r),
    Option::None => {}
  }
  a.clear();
}
