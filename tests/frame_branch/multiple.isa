@import "std.box"
@import "std.env"
fn choose() -> bool {
  let args = env::args();
  return args.len() == 1;
}
fn marker() {}
fn first() {
  print(100);
}
fn checkpoint() {
  print(200);
}
fn main() {
  let text = String::from("root");
  let flag = choose();
  marker();
  first();
  if flag {
    checkpoint();
  } else {
    print(300);
  }
  print(text);
}
