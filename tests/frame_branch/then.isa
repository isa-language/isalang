@import "std.box"
@import "std.env"
fn choose() -> bool {
  print(100);
  let args = env::args();
  return args.len() == 1;
}
fn marker() {}
fn checkpoint() {
  print(200);
}
fn main() {
  let text = String::from("root");
  let flag = choose();
  marker();
  if flag {
    let local = String::from("branch");
    print(local);
    checkpoint();
    print(local);
  } else {
    print(300);
  }
  let tail = String::from("tail");
  let view = &text;
  print(view);
  print(tail);
  let i = 0;
  while i<3 {
    i = i + 1;
    if i == 1 {
      continue;
    }
    print(i);
    if i == 2 {
      break;
    }
  }
}
