@import "std.box"
@import "std.env"
fn choose() -> bool {
  let args = env::args();
  return args.len() == 1;
}
fn marker() {}
fn checkpoint() {
  print(200);
}
fn fallback() -> Result<String, i32> {
  return Result::Err(9);
}
fn worker(text: String) -> Result<String, i32> {
  let flag = choose();
  marker();
  if flag {
    let local = String::from("branch");
    print(local);
    checkpoint();
  }
  else {
    print(300);
  }
  let tail = String::from("tail");
  print(tail);
  text.push_str("!");
  return Result::Ok(text.move());
}
fn main() {
  let result = worker(String::from("owned"));
  match result.move() {
    Result::Ok(value) => print(value),
    Result::Err(code) => print(code),
  }
}
