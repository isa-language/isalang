@import "std.box"
@import "std.env"
fn outer() -> bool {
  print(10);
  let args = env::args();
  return args.len()<3;
}
fn inner() -> bool {
  print(20);
  let args = env::args();
  return args.len() == 1;
}
fn marker() {}
fn checkpoint() {
  print(200);
}
fn main() {
  let text = String::from("root");
  let condition = outer();
  marker();
  if condition {
    let middle = String::from("middle");
    if inner() {
      let local = String::from("inner");
      print(local);
      checkpoint();
      print(local);
    } else {
      print(30);
    }
    print(middle);
    let tail = String::from("branch-tail");
    print(tail);
  } else {
    print(40);
  }
  print(text);
}
