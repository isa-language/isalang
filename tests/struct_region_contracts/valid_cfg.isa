struct View {
  value: &i32,
}
fn forward(value: View, count: i32) -> View {
  if count == 0 {
    return value.move();
  }
  return forward(value.move(), count - 1);
}
fn choose(value: View, condition: bool) -> View {
  let choice = match condition {
    true => 1,
    false => 0
  };
  if choice == 1 {
    return value.move();
  }
  return value.move();
}
fn main() -> i32 {
  let number = 10;
  let i = 0;
  while i < 3 {
      let view = forward(View {
        value: &number
    }, 2);
    let selected = choose(view.move(), i == 0);
    print(selected.value);
    selected.drop();
    number = number + 1;
    i = i + 1;
  }
  return 0;
}
