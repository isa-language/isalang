struct View {
  read: &String,
  edit: &mut String,
  owner: String,
}
fn forward(input: View) -> View {
  return input.move();
}
fn main() {
  let a = String::from("a");
  let b = String::from("b");
    let result = forward(View {
      read: &a,
      edit: &mut b,
      owner: String::from("owner")
  });
  print(result.read);
  let edit = &mut result.edit;
  edit.push_str("!");
  result.drop();
  a.push_str("?");
  print(a);
  print(b);
}
