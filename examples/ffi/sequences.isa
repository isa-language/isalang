extern "C" fn sum(values: &i32[]) -> i32;
extern "C" fn update(values: &mut u8[3]);
extern "C" fn text_length(text: &String) -> usize;
fn main() {
  let values: i32[3] = [10, 20, 12];
  let bytes: u8[3] = [1u8, 2u8, 3u8];
  let text = String::from("Olá");
  unsafe {
    @println("sum={} bytes={}", sum(&values), text_length(&text));
    update(&mut bytes);
  }
  @println("{} {} {}", bytes[0], bytes[1], bytes[2]);
}
