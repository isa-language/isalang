@macro format {
  ($($args: tt) *) => {
    @__format($($args) *)
  }
}
@macro print {
  ($($args: tt) *) => {
    @__print($($args) *)
  }
}
@macro println {
  ($($args: tt) *) => {
    @__println($($args) *)
  }
}
@macro input {
  ($($args: tt) *) => {
    @__input($($args) *)
  }
}
@macro panic {
  () => {
    panic("explicit panic")
  }
  ($($args: tt) +) => {
    {
      let message = @format($($args) *);
      panic(message.as_str());
    }
  }
}
@macro assert {
  ($condition: expr) => {
    if !($condition) {
      panic("assertion failed");
    }
  }
  ($condition: expr, $($args: tt) +) => {
    if !($condition) {
      @panic($($args) *);
    }
  }
}
