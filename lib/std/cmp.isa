@import "std.string"

impl i8 {
  pub fn hash(shared self) -> usize {
    let bits = self as usize;
    return bits ^(bits >> 16usize);
  }
  pub fn equals(shared self, other: &i8) -> bool {
    return self == other;
  }
  pub fn compare(shared self, other: &i8) -> i32 {
    if self < other {
      return -1;
    }
    if self > other {
      return 1;
    }
    return 0;
  }
}
