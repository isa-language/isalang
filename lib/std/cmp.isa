impl f32 {
  pub fn compare(shared self, other: &f32) -> i32 {
    if self != self || other != other {
      panic("unordered comparison");
    }
    if self < other {
      return -1;
    }
    if self > other {
      return 1;
    }
    return 0;
  }
}
