  }
}
impl String {

  pub fn hash(shared self) -> usize {
    let result = 2166136261usize;
    for i in 0usize..self.len() {
      if self.is_char_boundary(i) {
        let scalar = self.char_at(i).unwrap() as usize;
        result =(result ^ scalar) * 16777619usize;
      }
    }
    return result;
  }
  pub fn equals(shared self, other: &String) -> bool {
    return self.compare(other) == 0;
  }
  pub fn compare(shared self, other: &String) -> i32 {
    let count = self.len();
    if other.len() < count {
      count = other.len();
    }
    for i in 0usize..count {
      if self.is_char_boundary(i) {
        let left = self.char_at(i).unwrap() as u32;
        let right = other.char_at(i).unwrap() as u32;
        if left < right {
          return -1;
        }
        if left > right {
          return 1;
        }
      }
    }
    if self.len() < other.len() {
      return -1;
    }
    if self.len() > other.len() {
      return 1;
    }
    return 0;
  }
}
