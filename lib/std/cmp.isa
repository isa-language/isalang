impl bool {
  pub fn hash(shared self) -> usize {
    if self {
      return 1;
    }
    return 0;
  }
  pub fn equals(shared self, other: &bool) -> bool {
    return self == other;
  }
  pub fn compare(shared self, other: &bool) -> i32 {
    if self == other {
      return 0;
    }
    if self {
      return 1;
    }
    return -1;
  }
}
