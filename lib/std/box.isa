@import "std.mem"
@representation "box_i32"
pub struct BoxI32 {
  ptr: RawPtr,
}
impl BoxI32 {
  @intrinsic "box.new"
  pub fn new(value: i32) -> BoxI32;
  pub fn get(shared self) -> i32 {
    return isac_rt_load_i32(self.ptr);
  }
  pub fn set(unique self, value: i32) {
    isac_rt_store_i32(self.ptr, value);
  }
}

@representation "generic_box"
pub struct Box<T> {
  value: T,
}
impl<T> Box<T> {
  @intrinsic "box.generic.new"
  pub fn new(value: T) -> Box<T>;
  @intrinsic "box.generic.get"
  pub fn get(shared self) -> &T;
  @intrinsic "box.generic.into_inner"
  pub fn into_inner(self) -> T;
}
