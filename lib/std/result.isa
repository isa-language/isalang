pub enum Result<T, E> {
  Ok(T),
  Err(E),
}
@representation "input_result" pub struct ResultI32 {
  ptr: RawPtr,
  len: usize,
  capacity: usize,
}
impl ResultI32 {
  @intrinsic "io.result_ok" pub fn is_ok(shared self) -> bool;
  @intrinsic "io.result_error" pub fn error(shared self) -> i32;
  @intrinsic "io.result_i32" pub fn value(shared self) -> i32;
}
@representation "input_result" pub struct ResultI64 {
  ptr: RawPtr,
  len: usize,
  capacity: usize,
}
impl ResultI64 {
  @intrinsic "io.result_ok" pub fn is_ok(shared self) -> bool;
  @intrinsic "io.result_error" pub fn error(shared self) -> i32;
  @intrinsic "io.result_i64" pub fn value(shared self) -> i64;
}
