@import "std.collections.hash_map"
@initializer("create", "insert")
pub struct HashSet<T> {
  map: HashMap<T, bool>,
}
impl<T> HashSet<T> {
  pub fn create() -> HashSet<T> {
    let set = HashSet<T>::new();
    set.map = HashMap<T, bool>::create();
    return set.move();
  }
  pub fn len(shared self) -> usize {
    return self.map.len();
  }
  pub fn is_empty(shared self) -> bool {
    return self.map.is_empty();
  }
  pub fn contains(shared self, value: T) -> bool {
    return self.map.contains_key(value.move());
  }
  pub fn contains_ref(shared self, value: &T) -> bool {
    return self.map.contains_key_ref(value);
  }
  pub fn insert(unique self, value: T) -> bool {
    let previous = self.map.insert(value.move(), true);
    match previous {
      Some(_) => {
        return false;
      },
      None => {
        return true;
      }
    }
  }
  pub fn remove(unique self, value: T) -> bool {
    let previous = self.map.remove(value.move());
    match previous {
      Some(_) => {
        return true;
      },
      None => {
        return false;
      }
    }
  }
  pub fn remove_ref(unique self, value: &T) -> bool {
    match self.map.remove_ref(value) {
      Some(_) => {
        return true;
      },
      None => {
        return false;
      },
    }
  }
  pub fn clear(unique self) {
    self.map.clear();
  }
}
