@intrinsic "isac_rt_env_argument_count"
pub fn argument_count() -> usize;

@intrinsic "isac_rt_env_argument"
pub fn argument(index: usize) -> str;

@import("std.vec", "std.string", "std.result")

pub fn args() -> Vec<String> {
  let values = Vec<String>::with_capacity(argument_count());
  for i in 0usize..argument_count() {
    values.push(String::from(argument(i)));
  }
  return values.move();
}
pub fn var(name: str) -> Result<String, i32> {
  let value = String::new();
  let error = value.env_var_internal(name);
  if error != 0 {
    return Result::Err(error);
  }
  return Result::Ok(value.move());
}
