@representation "string_utf8"
pub struct String {
  ptr: RawPtr,
  len: usize,
  capacity: usize,
}
impl String {

  @intrinsic "string.read_file"
  fn read_file_internal(unique self, path: str) -> i32;
  @intrinsic "string.env_var"
  fn env_var_internal(unique self, name: str) -> i32;
  @intrinsic "string.new"
  pub fn new() -> String;
  @intrinsic "string.from"
  pub fn from(text: str) -> String;
  @intrinsic "string.len"
  pub fn len(shared self) -> usize;
  @intrinsic "string.capacity"
  pub fn capacity(shared self) -> usize;
  @intrinsic "string.is_empty"
  pub fn is_empty(shared self) -> bool;
  @intrinsic "string.as_str"
  pub fn as_str(shared self) -> str;
  @intrinsic "string.push_str"
  pub fn push_str(unique self, text: str);
  @intrinsic "string.clear"
  pub fn clear(unique self);
}

impl String {
  @intrinsic "string.char_at"
  fn char_at_scalar(shared self, index: usize) -> char;
  @intrinsic "string.is_char_boundary"
  pub fn is_char_boundary(shared self, index: usize) -> bool;

  pub fn char_at(shared self, index: usize) -> Option<char> {
    if index >= self.len() || !self.is_char_boundary(index) {
      return Option::None;
    }
    return Option::Some(self.char_at_scalar(index));
  }

  pub fn find_from(shared self, needle: char, start: usize) -> Option<usize> {
    let index = start;
    while index < self.len() {
      if self.is_char_boundary(index) {
        if self.char_at_scalar(index) == needle {
          return Option::Some(index);
        }
      }
      index = index + 1;
    }
    return Option::None;
  }
}
