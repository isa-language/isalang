@import "core.runtime"

pub struct Duration {
  nanos: u64,
}
impl Duration {
  pub fn set_nanos(unique self, value: u64) {
    self.nanos = value;
  }
  pub fn as_nanos(shared self) -> u64 {
    return self.nanos;
  }
  pub fn as_millis(shared self) -> u64 {
    return self.nanos / 1000000u64;
  }
  pub fn as_seconds(shared self) -> f64 {
    return(self.nanos as f64) / 1000000000.0;
  }
}

pub struct Instant {
  ticks: u64,
  initialized: bool,
}
impl Instant {
  pub fn reset(unique self) {
    self.ticks = isac_rt_monotonic_ns();
    self.initialized = true;
  }
  pub fn elapsed_nanos(shared self) -> u64 {
    if !self.initialized {
      panic("Instant requires reset before elapsed_nanos");
    }
    return isac_rt_monotonic_ns() - self.ticks;
  }
}

pub struct Clock {
  ticks: u64,
  initialized: bool,
}
impl Clock {
  pub fn delta(unique self) -> f64 {
    let now = isac_rt_monotonic_ns();
    let elapsed = 0u64;
    if self.initialized {
      elapsed = now - self.ticks;
    }
    self.ticks = now;
    self.initialized = true;
    return(elapsed as f64) / 1000000000.0;
  }
}

@import "std.result"
pub fn sleep(duration: &Duration) -> Result<bool, i32> {
  let error = isac_rt_sleep_ns(duration.as_nanos());
  if error != 0 {
    return Result::Err(error);
  }
  return Result::Ok(true);
}
pub fn unix_nanos() -> u64 {
  return isac_rt_unix_ns();
}
impl Duration {
  pub fn from_nanos(value: u64) -> Duration {
    let duration = Duration::new();
    duration.nanos = value;
    return duration.move();
  }
  pub fn from_millis(value: u64) -> Duration {
    if value >(0u64 - 1) / 1000000u64 {
      panic("duration overflow");
    }
    return Duration::from_nanos(value * 1000000u64);
  }
}
impl Instant {
  pub fn now() -> Instant {
    let instant = Instant::new();
    instant.reset();
    return instant.move();
  }
}
