pub struct Color {
  pub r: u8,
  pub g: u8,
  pub b: u8,
  pub a: u8,
}

impl Color {
  pub fn initialize(unique self, r: u8, g: u8, b: u8, a: u8) {
    self.r = r;
    self.g = g;
    self.b = b;
    self.a = a;
  }
  pub fn rgba(shared self) -> u32 {
    return((self.r as u32) << 24u32) |((self.g as u32) << 16u32) |
    ((self.b as u32) << 8u32) |(self.a as u32);
  }
}
