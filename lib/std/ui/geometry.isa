pub struct Point {
  pub x: f32,
  pub y: f32,
}
impl Point {
  pub fn initialize(unique self, x: f32, y: f32) {
    self.x = x;
    self.y = y;
  }
  pub fn translate(unique self, dx: f32, dy: f32) {
    self.x = self.x + dx;
    self.y = self.y + dy;
  }
}
pub struct Rect {
  pub x: f32,
  pub y: f32,
  pub width: f32,
  pub height: f32,
}
impl Rect {
  pub fn initialize(unique self, x: f32, y: f32, width: f32, height: f32) {
    self.x = x;
    self.y = y;
    self.width = width;
    self.height = height;
  }

  pub fn contains(shared self, x: f32, y: f32) -> bool {
    return self.width > 0.0f32 && self.height > 0.0f32 &&
    x >= self.x && y >= self.y &&
    x < self.x + self.width && y < self.y + self.height;
  }
}
